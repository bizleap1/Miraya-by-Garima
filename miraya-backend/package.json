{
  "name": "miraya-backend",
  "version": "1.0.0",
  "description": "Miraya E-Commerce Production-Grade Backend API",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "reset:orders": "node src/scripts/resetOrders.js",
    "test:security": "node --test tests/security_remediation.test.js",
    "test:phase1:db": "node tests/phase1.db.integration.test.js",
    "test:phase2": "node --test tests/phase2.test.js",
    "test:phase2:db": "node tests/phase2.db.integration.test.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@prisma/client": "^6.3.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "embedded-postgres": "^18.4.0-beta.17",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "pdfkit": "^0.16.0",
    "razorpay": "^2.9.5",
    "resend": "^4.1.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "prisma": "^6.3.0"
  },
  "overrides": {
    "multer-storage-cloudinary": {
      "cloudinary": "$cloudinary"
    }
  }
}
